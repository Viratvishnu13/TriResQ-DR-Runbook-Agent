{
  "scenario_id": "db_failover_transient",
  "extends": "nominal_success",
  "title": "Database failover fails once, then succeeds",
  "description": "A transient failure. The retry needs a fresh approval.",
  "expected_outcome": "Pass with deviations",
  "actions": {
    "failover_database": {
      "attempts": [
        {
