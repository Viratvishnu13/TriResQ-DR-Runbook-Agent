# Copy to .env. Leave blank to run without a model. Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Azure OpenAI instead (OPENAI_MODEL is then the deployment name):
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=

# Optional approval-signing key. If unset, a random one is created in data/approval.key.
# APPROVAL_SECRET=
