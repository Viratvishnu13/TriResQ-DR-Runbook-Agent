# Copy to .env and edit. Placeholder values only in this file; never commit or ship a real .env.

# OpenAI API key used by the local backend for AI features (without it the drill still works).
OPENAI_API_KEY=your_key_here
# Model name for all AI features (with Azure OpenAI, your deployment name).
OPENAI_MODEL=gpt-4.1-mini

# Optional settings below stay commented out unless you need them.

# Alternative OpenAI-compatible API address (leave unset to use OpenAI).
# OPENAI_BASE_URL=your_base_url_here
# Azure OpenAI endpoint, used instead of OpenAI when set together with the Azure key.
# AZURE_OPENAI_ENDPOINT=your_azure_endpoint_here
# Azure OpenAI API key.
# AZURE_OPENAI_API_KEY=your_azure_key_here
# Key for signing approval tokens; if unset, a random one is created in data/ on first run.
# APPROVAL_SECRET=your_signing_secret_here
# Port for the web app and API (default 8088).
# PORT=8088
